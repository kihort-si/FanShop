<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FanShop.View.EditEmployeeControl">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="720">
            <TextBlock Text="Карточка сотрудника" FontSize="24" FontWeight="Bold" />
            <TextBox x:Name="SurnameTextBox"
                     Watermark="Фамилия"
                     Text="{Binding Surname}"
                     KeyDown="InputTextBox_KeyDown" />
            <TextBox x:Name="FirstNameTextBox"
                     Watermark="Имя"
                     Text="{Binding FirstName}"
                     KeyDown="InputTextBox_KeyDown" />
            <TextBox x:Name="LastNameTextBox"
                     Watermark="Отчество"
                     Text="{Binding LastName}"
                     KeyDown="InputTextBox_KeyDown" />
            <TextBox x:Name="DateOfBirthTextBox"
                     Watermark="Дата рождения"
                     MaxLength="10"
                     Text="{Binding DateOfBirth}"
                     KeyDown="InputTextBox_KeyDown"
                     TextChanged="DateOfBirthTextBox_TextChanged" />
            <TextBlock Text="{Binding DateOfBirthError}"
                       Foreground="#D64545"
                       FontSize="12"
                       Margin="2,-8,0,0"
                       IsVisible="{Binding IsDateOfBirthErrorVisible}" />
            <TextBox x:Name="PlaceOfBirthTextBox"
                     Watermark="Место рождения"
                     Text="{Binding PlaceOfBirth}"
                     KeyDown="InputTextBox_KeyDown" />
            <TextBox x:Name="PassportTextBox"
                     Watermark="Паспорт"
                     Text="{Binding Passport}"
                     KeyDown="InputTextBox_KeyDown" />
            <Separator Margin="0,8" />
            <TextBlock Text="Настройки новых смен" FontSize="18" FontWeight="Bold" />
            <CheckBox Content="Постоянный пропуск" IsChecked="{Binding HasPermanentPass}" />
            <TextBlock Text="В будни галочка «Пропуск» будет выключена. В субботу и воскресенье она включается автоматически."
                       TextWrapping="Wrap" Foreground="#6E7E8F" />
            <CheckBox Content="Не включать в ЗП по умолчанию" IsChecked="{Binding ExcludeFromSalaryByDefault}" />
            <TextBlock Text="В новых сменах галочка «ЗП» будет выключена. Уже назначенные смены не изменятся."
                       TextWrapping="Wrap" Foreground="#6E7E8F" />
            <TextBlock Text="Магазин по умолчанию" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding DefaultShops}" SelectedItem="{Binding SelectedDefaultShop}"
                      PlaceholderText="Использовать общий магазин по умолчанию" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ShopName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Должность по умолчанию" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding DefaultPositions}" SelectedItem="{Binding SelectedDefaultPosition}"
                      PlaceholderText="Использовать должность магазина по умолчанию" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding PositionName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="ghost" Content="Сбросить магазин и должность" Command="{Binding ClearDefaultWorkplaceCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Сохранить" Command="{Binding SaveEditedEmployeeCommand}" />
                <Button Classes="ghost" Content="Отмена" Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
