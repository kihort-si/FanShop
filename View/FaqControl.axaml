<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FanShop.View.FaqControl">

    <UserControl.Styles>
        <Style Selector="Border.faq-card">
            <Setter Property="Background" Value="{StaticResource BrandSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrandText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.question">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrandText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.answer">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextSubtle}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style Selector="Expander.faq-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander.faq-item > TextBlock">
            <Setter Property="Margin" Value="0,5,0,10" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16" MaxWidth="980"
                    HorizontalAlignment="Center">

            <Border CornerRadius="16" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#075A91" Offset="0" />
                        <GradientStop Color="#009EE1" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Центр помощи"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="Инструкции по корректировке отчёта, ценникам, календарю, сменам и документам"
                                   FontSize="14"
                                   Foreground="#E8F7FF"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="64" Height="64"
                            Margin="20,0,0,0"
                            CornerRadius="32"
                            Background="#25FFFFFF">
                        <icons:MaterialIcon Kind="FrequentlyAskedQuestions"
                                            Width="34" Height="34"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Classes="faq-card" Background="#EFF8FE" BorderBrush="#B9DFF3">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{StaticResource BrandAccent}">
                        <icons:MaterialIcon Kind="LightbulbOnOutline"
                                            Width="22" Height="22"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3">
                        <TextBlock Text="Новые возможности"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="answer"
                                   Text="В меню появился раздел «Ценники 1С»: отсканируйте нужные штрихкоды и поставьте ценники на печать." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                        <icons:MaterialIcon Kind="CalendarMonth" Width="24" Height="24"
                                            Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="section-title" Text="Календарь и смены" />
                    </StackPanel>

                    <Expander Classes="faq-item" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как добавить смену на один день?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Дважды нажмите на нужный день, выберите «Добавить», затем сотрудника, магазин, должность и занятость. Если магазин или должность только одни, они подставятся автоматически." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как назначить сотрудника сразу на несколько дней?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Нажмите кнопку с сотрудниками и плюсом над календарём, выберите сотрудника, а затем последовательно нажимайте на нужные дни. Повторное нажатие на кнопку с галочкой завершит режим. После этого программа предложит создать один пропуск на все выбранные дни." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как быстро перейти к другому месяцу или году?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Нажмите кнопку с календарём в верхней панели, выберите год стрелками и нужный месяц в таблице. Кнопка с домиком возвращает к текущему месяцу." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как изменить или удалить уже назначенную смену?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Откройте день двойным нажатием. В таблице можно сразу изменить магазин, должность, занятость и признаки включения в пропуск или зарплату. Для удаления выделите сотрудника и нажмите «Удалить»." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Почему имена в календаре имеют разные оттенки синего?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Оттенок плашки помогает отличить сотрудников разных магазинов. Кнопка фильтра справа позволяет показать всех сотрудников или только выбранный магазин. Фильтр доступен в режиме отображения сотрудников." />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                        <icons:MaterialIcon Kind="Store" Width="24" Height="24"
                                            Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="section-title" Text="Магазины, должности и сотрудники" />
                    </StackPanel>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Где добавить магазин и должности?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Откройте «Настройки». Там можно создавать магазины, добавлять должности внутри каждого магазина, изменять их и задавать зарплату. Изменения сразу появляются во всех окнах выбора." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Для чего нужны магазин и должность по умолчанию?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Основной магазин выбирается автоматически при добавлении смены и показывается первым в деталях дня. Для каждого магазина можно отметить основную должность — она подставится при выборе или смене магазина." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как перенести сотрудника в другой магазин только на конкретный день?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Откройте детали нужного дня и измените магазин прямо в строке сотрудника. Должность сменится на основную для нового магазина, после чего при необходимости можно выбрать другую. Карточка самого сотрудника при этом не изменяется." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как добавить или отредактировать сотрудника?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Откройте раздел «Сотрудники». Кнопка «Добавить» создаёт новую карточку, а «Изменить» редактирует выбранную. Перед удалением программа попросит подтверждение." />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                        <icons:MaterialIcon Kind="BadgeAccountOutline" Width="24" Height="24"
                                            Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="section-title" Text="Пропуска и зарплата" />
                    </StackPanel>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как сформировать пропуск?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Откройте нужный день, проверьте отметки в столбце «Пропуск» и нажмите «Пропуск». Будет создан Word-документ только для отмеченных сотрудников. После успешной печати эти смены больше не будут предлагаться для повторного включения." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Что происходит с пропуском при множественном добавлении?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="При завершении режима можно сразу сформировать общий документ на выбранные дни. Если отказаться, смены сохранятся, а отметки «Пропуск» останутся включёнными — документ можно создать позже." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как изменить шаблон пропуска?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Выберите в главном меню «Шаблон пропуска». Откроется используемый DOCX-файл, который можно отредактировать и сохранить." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как исключить смену из расчёта зарплаты?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="В деталях дня снимите отметку в столбце «Зарплата». Смена останется в календаре, но будет показана в аналитике как не включённая в зарплату." />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                        <icons:MaterialIcon Kind="ChartBoxOutline" Width="24" Height="24"
                                            Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="section-title" Text="Аналитика и Excel" />
                    </StackPanel>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Что показывает аналитика затрат?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Раздел показывает общие итоги за выбранный период: сотрудников, смены, включённые и не включённые в зарплату выходы и итоговую сумму. Также доступны разрезы по матчам, сотрудникам и отдельным сменам." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Где посмотреть статистику по магазинам и должностям?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="В аналитике затрат дополнительные таблицы появляются автоматически, когда настроено несколько магазинов или должностей. Общая суммарная статистика при этом сохраняется. Та же детализация включается в экспорт Excel." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как выгрузить данные в Excel?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Выберите период, нажмите «Обновить», а затем «Экспорт Excel». Для тайминга экспорт также доступен из аналитики задач и из окна конкретного дня." />
                    </Expander>
                </StackPanel>
            </Border>
            
            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                        <icons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="24" Height="24"
                                            Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="section-title" Text="Ценники 1С" />
                    </StackPanel>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="С чего начать работу с ценниками?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Откройте в меню «Ценники 1С» и загрузите XLSX-справочник с колонками Штрихкод, Артикул, Номенклатура и Характеристика. XLSX можно перетащить на вкладку. Штрихкоды лучше выгружать как текст, чтобы сохранить начальные нули. Неполные строки перечислены в «Пропущенные строки Excel»; конфликт одного штрихкода с разными товарами отменяет загрузку." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как сканировать с другого компьютера?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Подключите кассу и ноутбук к доступной локальной сети. Во вкладке ценников выберите подходящий сетевой адрес, нажмите «Скопировать адрес» и откройте его в браузере кассы. Сканер должен завершать код клавишей Enter. При открытии раздела сервер запускается автоматически; порт по умолчанию 8765. Если адрес недоступен, проверьте сеть и разрешённый доступ к этому порту. После смены сети обновите адреса." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Можно ли работать без сетевого подключения кассы?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Да. На кассе отсканируйте товары в текстовый файл: один штрихкод в строке, включая повторения. Сохраните TXT и перенесите его на ноутбук. Нажмите «Импортировать TXT» или перетащите файл на вкладку ценников. Каждая непустая строка считается отдельным сканированием, поэтому повторные коды увеличивают количество." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Почему кнопка «Передать в 1С» недоступна?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Проверьте неизвестные штрихкоды и сообщения раздела: неизвестные позиции блокируют передачу. В истории можно показать только неизвестные и удалить выбранное сканирование. Исправьте справочник, загрузите его снова, удалите прежнюю неизвестную запись и отсканируйте товар заново — загрузка каталога не меняет результаты старых сканирований. «Отменить последнее» удаляет последнее сканирование, а не всю сгруппированную позицию." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как передать позиции и управлять передачей?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Передача клавиатурой работает на Windows с локально открытой 1С. Откройте обработку печати ценников, нажмите «Добавить» и поставьте курсор в пустое поле выбора номенклатуры. В FanShop нажмите «Передать в 1С», проверьте очередь, вернитесь в 1С и нажмите F8. F9 запрашивает паузу после завершения строки, Esc останавливает передачу. При потере фокуса передача прерывается. Выполненные позиции при продолжении не вводятся повторно; частично введённую строку нужно проверить вручную. Сначала проверьте короткую партию и при необходимости увеличьте задержки." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как продолжить после закрытия приложения или начать новую партию?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Незавершённая сессия и очередь сохраняются. При следующем запуске раздел предложит восстановление или удаление сохранённых данных. Сверьте историю, количества и состояния очереди перед продолжением. Завершение очереди не очищает сканы: для следующей партии явно очистите сессию, иначе повторное создание очереди включит прежние товары." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Что делать, если связь с кассой прервалась?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Дождитесь восстановления соединения или нажмите на странице кассы «Повторить отправку ожидающих». Не закрывайте вкладку браузера, пока в ней остаются ожидающие запросы. Повторная отправка одного запроса не увеличивает количество дважды. Перед очисткой сессии дождитесь нулевого числа ожидающих сканов. Если подключение недоступно, используйте импорт TXT." />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                        <icons:MaterialIcon Kind="TimerOutline" Width="24" Height="24"
                                            Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="section-title" Text="Тайминг и расписание матчей" />
                    </StackPanel>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как вести тайминг задач?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Сначала создайте категории в разделе «Тайминг». Затем откройте нужный день, нажмите «Тайминг» и добавляйте задачи с временем выполнения. Кнопка со стрелками над календарём переключает отображение сотрудников и задач." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как посмотреть аналитику задач?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="В разделе «Тайминг» нажмите «Аналитика» и выберите период. Результат можно просмотреть в программе или экспортировать в Excel." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Что делать, если расписание матчей устарело?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Выберите в главном меню «Обновить расписание» и проверьте подключение к интернету. Помните, что дата и время будущего матча могут быть изменены организаторами." />
                    </Expander>
                </StackPanel>
            </Border>
            
            
            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                        <icons:MaterialIcon Kind="ChartBoxOutline" Width="24" Height="24"
                                            Foreground="{StaticResource BrandPrimary}" />
                        <TextBlock Classes="section-title" Text="Корректировка отчёта" />
                    </StackPanel>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как загрузить отчёт и найти варианты?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Откройте в меню «Корректировка отчёта» и нажмите «Загрузить отчёт». В XLSX нужны столбцы N, Номенклатура, Характеристика, Продано, Цена, % руч. и Сумма. Проверьте число строк и исходный итог, задайте сумму корректировки и нажмите «Найти варианты». Сведения о ручной скидке, НДС и документе реализации тоже импортируются, если они присутствуют." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как учесть несколько конкретных позиций?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Включите «Учитывать конкретные позиции вместо общей суммы». Добавьте позиции и заполните название, характеристику, количество, цену и разрешённую скидку. Их общая сумма станет требуемой корректировкой. Если нужна только сумма, оставьте этот режим выключенным: создавать фиктивный товар не требуется." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как запретить изменение строки или разрешить её исключение?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="«Использовать в подборе» включает строку в поиск, «Менять скидку» разрешает изменение её скидки. Отметка «Не изменять» запрещает любые действия со строкой. Выделите несколько строк с Ctrl/Shift, чтобы защитить их или снять защиту одной кнопкой. Исключение по умолчанию запрещено: его нужно отдельно разрешить в нужной строке. В результате оно будет обозначено «ИСКЛЮЧИТЬ СТРОКУ»." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Почему размерные товары не участвуют в поиске?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Они по умолчанию отключены. Можно вручную включить конкретные строки или после полностью завершённого поиска без точного решения нажать «Расширить поиск на незащищённые размерные товары». Защищённые позиции останутся недоступными. Расширение выполняется только по вашему действию." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Что делать с предупреждением о правиле расчёта скидки?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Программа сверяет выбранное правило с фактическими суммами отчёта и учитывает количество товара. MathematicalRound округляет денежную скидку до целого рубля, DecimalRound2 — до копейки; половины округляются от нуля. При несовпадении выберите подходящее правило. Можно явно разрешить расчётный предпросмотр, но соответствие таких вариантов вашей 1С не подтверждено: перед оформлением обязательно сверьте расчёт." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Почему один вариант рекомендуется раньше другого?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Сначала предпочтительны варианты без исключения строк, затем — с меньшим числом изменений. При одинаковом числе изменений лучше меньше затрагивать размерные и обычные товары, использовать услуги и MISC, а затем учитывать приоритет скидок и величину их изменения. Каждый показанный вариант отдельно проверяется на разрешения строк и точное сохранение итога." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Что означает отсутствие точного решения или ограничение поиска?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Точные варианты должны компенсировать требуемую сумму до копейки. Если совпадения нет, основной список остаётся пустым; можно проверить разрешения и явно расширить подбор. Опция ближайшего отклонения показывает его отдельно с пометкой «НЕ ЯВЛЯЕТСЯ ТОЧНЫМ РЕШЕНИЕМ». При достижении лимита программа сообщает, что отсутствие других решений и оптимальность найденных не доказаны. Поиск можно отменить кнопкой «Отменить поиск»." />
                    </Expander>

                    <Expander Classes="faq-item">
                        <Expander.Header>
                            <TextBlock Classes="question" Text="Как читать результат и перенести корректировку в 1С?" />
                        </Expander.Header>
                        <TextBlock Classes="answer"
                                   Text="Выберите вариант: таблица покажет скидки, суммы и разницы для изменяемых строк. Флажок «Показать весь отчёт после корректировки» добавляет остальные строки. Контрольный блок уже учитывает компенсацию и добавляемую корректировку; разница до/после должна быть 0 ₽. «Скопировать инструкцию» копирует пошаговые действия. Исходный XLSX не изменяется, автоматического ввода в 1С здесь нет. Вручную проверьте округление, НДС и оформление документа. После изменения условий предыдущие результаты очищаются; отчёт при новом запуске нужно загрузить заново." />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Classes="faq-card">
                <StackPanel Spacing="7">
                    <TextBlock Classes="section-title" Text="Обновление программы" />
                    <Expander Classes="faq-item">
                        <Expander.Header><TextBlock Classes="question" Text="Как устанавливаются новые версии?" /></Expander.Header>
                        <TextBlock Classes="answer" Text="На Windows FanShop проверяет обновления при каждом запуске, в том числе в разделах ценников и корректировки отчёта. Новая версия скачивается с прогрессом, проверяется и устанавливается автоматически, затем программа запускается снова. Runtime входит в поставку. Если папка защищена, Windows может запросить подтверждение прав. При отсутствии сети программа продолжает работать." />
                    </Expander>
                    <Expander Classes="faq-item">
                        <Expander.Header><TextBlock Classes="question" Text="Что происходит с данными и устаревшими DLL?" /></Expander.Header>
                        <TextBlock Classes="answer" Text="База, настройки, шаблон пропуска и сохранённые сканы остаются в AppData. Установщик заменяет компоненты поставки и удаляет известные устаревшие файлы по их контрольным суммам. Неизвестные или изменённые файлы сохраняются. При первом переходе со старого обновлятора очистка известных старых компонентов выполняется после запуска новой версии." />
                    </Expander>
                    <Expander Classes="faq-item">
                        <Expander.Header><TextBlock Classes="question" Text="Что делать, если обновление не завершилось?" /></Expander.Header>
                        <TextBlock Classes="answer" Text="При ошибке скачивания установленная версия продолжает работу. Новый установщик создаёт резервную копию и откатывает изменения, если новая программа не подтвердила запуск. После прерывания установки восстановление выполняется при следующем входе в Windows. Неудачная версия повторно пробуется через 6 часов, а новый релиз — сразу. Причина и пути резервных копий записаны в %LOCALAPPDATA%\FanShop\Updates\update.log. Не удаляйте незавершённый журнал и папку backup." />
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock Text="Не нашли ответ? Проверьте сообщения в нужном разделе и подсказки при наведении на кнопки."
                       Margin="8,2,8,12"
                       FontSize="12"
                       Foreground="{StaticResource BrandTextSubtle}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
