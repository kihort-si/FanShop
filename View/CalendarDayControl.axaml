<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FanShop.View.CalendarDayControl">
    <UserControl.Styles>
        <Style Selector="Border.day-frame">
            <Setter Property="Background" Value="{Binding HasMatch, Converter={StaticResource BoolToBackgroundConverter}}" />
            <Setter Property="BorderBrush" Value="#E2ECF5" />
        </Style>
        <Style Selector="Border.day-frame.adjacent-month">
            <Setter Property="Background" Value="#F0F3F6" />
            <Setter Property="BorderBrush" Value="#D7DFE7" />
        </Style>
        <Style Selector="Border.adjacent-month StackPanel.day-details">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
        <Style Selector="Border.adjacent-month Border.day-change-notice">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
    </UserControl.Styles>
    <Button Classes="cell"
            Command="{Binding ShowDayDetailsCommand}"
            ToolTip.Tip="{Binding DateTooltip}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Classes="day-frame"
                Classes.adjacent-month="{Binding !IsCurrentMonth}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding DayLabel}"
                               FontWeight="Bold"
                               Foreground="{Binding ., Converter={StaticResource DateToTodayColorConverter}}" />
                    <Border Grid.Column="1"
                            Classes="day-change-notice"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            Background="#FFC107"
                            IsVisible="{Binding ShowChangeNotice}"
                            ToolTip.Tip="Дата и время матча могут измениться">
                        <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                </Grid>

                <StackPanel Classes="day-details" Grid.Row="1" Spacing="3" IsVisible="{Binding IsEmployeeView}">
                    <ItemsControl ItemsSource="{Binding DisplayedEmployees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Background}" CornerRadius="4" Padding="4,2" Margin="0, 0,0,2">
                                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AdditionalEmployeesText}"
                               HorizontalAlignment="Center"
                               FontSize="10"
                               Foreground="#5D77A1"
                               IsVisible="{Binding IsAdditionalEmployeesTextVisible}" />
                </StackPanel>

                <StackPanel Classes="day-details" Grid.Row="1" Spacing="3" IsVisible="{Binding IsEmployeeView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding DisplayedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#113C66" CornerRadius="4" Padding="4,2" Margin="0, 0,0,2">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AdditionalTasksText}"
                               FontSize="10"
                               Foreground="#113C66"
                               IsVisible="{Binding IsAdditionalTasksTextVisible}" />
                </StackPanel>

                <StackPanel Classes="day-details" Grid.Row="2" Spacing="2" HorizontalAlignment="Center" IsVisible="{Binding HasMatch}">
                    <Image Source="{Binding Match.Logo}" Height="40" Stretch="Uniform" />
                    <TextBlock Text="{Binding Match.TeamName}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="MidnightBlue" />
                    <TextBlock Text="{Binding Match.SartTime}" HorizontalAlignment="Center" FontSize="11" Foreground="MidnightBlue" />
                </StackPanel>
            </Grid>
        </Border>
    </Button>
</UserControl>
