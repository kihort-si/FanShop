<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FanShop.View.PriceTagsControl">
 <UserControl.Styles>
  <Style Selector="Border.card"><Setter Property="Background" Value="{StaticResource BrandSurfaceAlt}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="{StaticResource BrandBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Styles>
 <ScrollViewer><StackPanel Margin="24" Spacing="16">
  <StackPanel><TextBlock Text="Ценники 1С" FontSize="28" FontWeight="Bold"/><TextBlock Text="Справочник → сканирование → проверка → передача в 1С" Foreground="{StaticResource BrandTextSubtle}"/></StackPanel>
  <Border Classes="card" IsVisible="{Binding RecoveryAvailable}" Background="#FFF4D6"><StackPanel Spacing="10"><TextBlock Text="Есть незавершённая сессия. Восстановите её перед новыми сканированиями." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding CanResolveRecovery}"><Button Content="Восстановить" Command="{Binding RestoreSessionCommand}"/><Button Content="Удалить сохранённую" Command="{Binding DiscardSavedCommand}"/></StackPanel></StackPanel></Border>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
   <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Справочник товаров" Classes="heading"/><TextBlock Text="{Binding CatalogStatus}" TextWrapping="Wrap"/><Button Content="Загрузить Excel" HorizontalAlignment="Left" Command="{Binding LoadExcelCommand}" IsEnabled="{Binding CanEdit}"/><Expander Header="Пропущенные строки Excel"><ItemsControl ItemsSource="{Binding CatalogWarnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></Border>
   <Border Grid.Column="1" Classes="card"><StackPanel Spacing="10"><TextBlock Text="Файл со сканированиями" Classes="heading"/><TextBlock Text="Одна строка TXT = одно сканирование. Пустые строки пропускаются." TextWrapping="Wrap"/><Button Content="Импортировать TXT" HorizontalAlignment="Left" Command="{Binding ImportTxtCommand}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="Можно перетащить TXT или XLSX в этот раздел." FontSize="12" Foreground="{StaticResource BrandTextSubtle}"/></StackPanel></Border>
  </Grid>
  <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Сканирование через сеть" Classes="heading"/><TextBlock Text="{Binding ServerStatus}" TextWrapping="Wrap"/>
   <WrapPanel><TextBlock Text="Порт: " VerticalAlignment="Center"/><NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Width="120" IsEnabled="{Binding CanEdit}"/><Button Content="Перезапустить сервер" Command="{Binding RestartServerCommand}" Margin="10,0" IsEnabled="{Binding CanEdit}"/><Button Content="Остановить" Command="{Binding StopServerCommand}"/><Button Content="Обновить адреса" Command="{Binding RefreshAddressesCommand}" Margin="10,0"/></WrapPanel>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><ComboBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Interface}"/><TextBlock Text="{Binding Url}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="Скопировать адрес" Command="{Binding CopyAddressCommand}"/></Grid>
   <TextBlock Text="{Binding LocalUrl}" FontSize="12" Foreground="{StaticResource BrandTextSubtle}"/>
  </StackPanel></Border>
  <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Текущая сессия" Classes="heading"/><TextBlock Text="{Binding Statistics}" TextWrapping="Wrap"/><Border Background="#FFF1F2" Padding="12" CornerRadius="8" IsVisible="{Binding HasUnknown}"><TextBlock Text="{Binding UnknownMessage}" Foreground="{StaticResource BrandDanger}" TextWrapping="Wrap"/></Border>
   <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True" Height="250" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="180"/><DataGridTextColumn Header="Номенклатура" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Характеристика" Binding="{Binding Characteristic}" Width="150"/><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="120"/></DataGrid.Columns></DataGrid>
   <WrapPanel><Button Content="Отменить последнее" Command="{Binding UndoCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="Очистить сессию" Command="{Binding ClearCommand}" IsEnabled="{Binding CanEdit}" Margin="10,0"/><Button Content="Передать в 1С" Command="{Binding PrepareTransferCommand}" IsEnabled="{Binding CanPrepare}"/></WrapPanel>
   <Expander Header="История сканирований / неизвестные штрихкоды"><StackPanel Spacing="10"><CheckBox Content="Только неизвестные" IsChecked="{Binding UnknownOnly}"/><DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedScan}" AutoGenerateColumns="False" IsReadOnly="True" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Время" Binding="{Binding Time, StringFormat='{}{0:dd.MM HH:mm:ss}'}" Width="160"/><DataGridTextColumn Header="Штрихкод" Binding="{Binding Barcode}" Width="*"/><DataGridTextColumn Header="Источник" Binding="{Binding SourceName}" Width="100"/><DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="200"/><DataGridTextColumn Header="Размер" Binding="{Binding Product.Characteristic}" Width="100"/></DataGrid.Columns></DataGrid><Button Content="Удалить выбранное сканирование" HorizontalAlignment="Left" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding CanEdit}"/></StackPanel></Expander>
  </StackPanel></Border>
  <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Передача в 1С" Classes="heading"/>
   <TextBlock Text="1. Откройте обработку печати ценников в 1С.&#10;2. Нажмите «Добавить».&#10;3. Убедитесь, что курсор находится в пустом поле «Номенклатура».&#10;4. Сформируйте очередь кнопкой «Передать в 1С», вернитесь в 1С и нажмите F8.&#10;F8 — начать/продолжить · F9 — пауза после строки · Esc — аварийная остановка." TextWrapping="Wrap"/>
   <TextBlock Text="{Binding TransferMessage}" TextWrapping="Wrap"/><TextBlock Text="{Binding Progress}" FontWeight="Bold"/><TextBlock Text="{Binding CurrentPosition}" FontSize="18"/>
   <StackPanel IsVisible="{Binding HasQueue}" Spacing="10"><CheckBox Content="Глобальные F8/F9/Esc включены" IsChecked="{Binding HotkeysArmed, Mode=OneWay}" IsEnabled="False"/><WrapPanel><Button Content="Включить F8/F9/Esc для продолжения" Command="{Binding ArmHotkeysCommand}" IsEnabled="{Binding CanManageQueue}"/><Button Content="Остановить передачу" Command="{Binding StopTransferCommand}" Margin="10,0"/><Button Content="Закрыть очередь" Command="{Binding CloseQueueCommand}" IsEnabled="{Binding CanManageQueue}"/></WrapPanel>
    <Border Background="#FFF4D6" CornerRadius="8" Padding="12" IsVisible="{Binding NeedsReview}"><StackPanel Spacing="8"><TextBlock Text="Проверьте текущую строку 1С. Продолжение заблокировано до вашего решения." TextWrapping="Wrap"/><WrapPanel IsEnabled="{Binding CanManageQueue}"><Button Content="Строка введена полностью" Command="{Binding ReviewCompletedCommand}"/><Button Content="Частичная строка удалена — повторить" Command="{Binding ReviewRetryCommand}" Margin="10,0"/></WrapPanel></StackPanel></Border>
    <Expander Header="Очередь и состояния позиций"><DataGrid ItemsSource="{Binding Queue}" Height="200" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="180"/><DataGridTextColumn Header="Размер" Binding="{Binding Characteristic}" Width="100"/><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="Состояние" Binding="{Binding StatusName}" Width="*"/></DataGrid.Columns></DataGrid></Expander>
   </StackPanel>
   <Expander Header="Настройки задержек, миллисекунды"><StackPanel Spacing="10" IsEnabled="{Binding CanConfigure}"><Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8"><TextBlock Text="После ввода артикула"/><NumericUpDown Grid.Column="1" Value="{Binding ArticleTextDelay}" Minimum="100" Maximum="10000" Increment="50"/><TextBlock Grid.Row="1" Text="После Enter артикула"/><NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ArticleEnterDelay}" Minimum="100" Maximum="10000" Increment="50"/><TextBlock Grid.Row="2" Text="После ввода характеристики"/><NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding CharacteristicTextDelay}" Minimum="100" Maximum="10000" Increment="50"/><TextBlock Grid.Row="3" Text="После Enter характеристики"/><NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding CharacteristicEnterDelay}" Minimum="100" Maximum="10000" Increment="50"/><TextBlock Grid.Row="4" Text="После количества / Enter"/><NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding QuantityDelay}" Minimum="100" Maximum="10000" Increment="50"/></Grid><Button Content="Сохранить настройки" Command="{Binding SaveDelaysCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>
  </StackPanel></Border>
  <Border Classes="card"><StackPanel Spacing="6"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="Требуется внимание: проверьте сообщение выше." Foreground="{StaticResource BrandDanger}" IsVisible="{Binding HasError}"/><TextBlock Text="{Binding DataDirectory}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrandTextSubtle}"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
