<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="using:FanShop.View"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FanShop.View.MainControl">
    <UserControl.Styles>
        <Style Selector="FlyoutPresenter.transparentFlyout">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto">
            <Grid Grid.Row="0" Width="770" HorizontalAlignment="Center" ColumnDefinitions="*,Auto,*" Margin="0,10,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                    <Button Width="40" Height="36" Margin="3,0" Command="{Binding GoToTodayCommand}" ToolTip.Tip="Вернуться к текущему месяцу">
                        <avalonia:MaterialIcon Kind="Home"/>
                    </Button>
                    <Button x:Name="CalendarPickerButton" Width="40" Height="36" Margin="3,0" ToolTip.Tip="Выбрать месяц и год">
                        <avalonia:MaterialIcon Kind="CalendarMonth"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft"
                                    FlyoutPresenterClasses="transparentFlyout">
                                <Border Padding="14"
                                        Background="White"
                                        BorderBrush="#D7E4EF"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Button Grid.Column="0" Height="34" Width="34" 
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Command="{Binding PreviousPickerYearCommand}"
                                                    Content="‹" FontSize="22" Padding="0"
                                                    Background="White"
                                                    Foreground="{StaticResource BrandPrimary}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PickerYear}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrandPrimary}"/>
                                            <Button Grid.Column="2" Height="34" Width="34"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Command="{Binding NextPickerYearCommand}"
                                                    Content="›" FontSize="22" Padding="0"
                                                    Background="White"
                                                    Foreground="{StaticResource BrandPrimary}"/>
                                        </Grid>

                                        <UniformGrid Columns="3" Rows="4">
                                            <Button Content="ЯНВ" Tag="1" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="ФЕВ" Tag="2" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="МАР" Tag="3" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="АПР" Tag="4" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="МАЙ" Tag="5" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="ИЮН" Tag="6" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="ИЮЛ" Tag="7" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="АВГ" Tag="8" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="СЕН" Tag="9" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="ОКТ" Tag="10" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="НОЯ" Tag="11" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                            <Button Content="ДЕК" Tag="12" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MonthButton_Click" Margin="3"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Width="40" Height="36" Margin="3,0" Command="{Binding StartMultiShiftModeCommand}"
                            ToolTip.Tip="Повторное нажатие завершает множественное добавление">
                        <Grid>
                            <avalonia:MaterialIcon Kind="AccountMultiplePlus"
                                                   IsVisible="{Binding IsMultiShiftMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <avalonia:MaterialIcon Kind="CheckBold" IsVisible="{Binding IsMultiShiftMode}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding PreviousMonthName}" Command="{Binding GoToPreviousMonthCommand}" Background="Transparent" BorderThickness="0" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentMonthName}" FontSize="20" FontWeight="Bold" Margin="20,0" VerticalAlignment="Center" />
                    <Button Content="{Binding NextMonthName}" Command="{Binding GoToNextMonthCommand}" Background="Transparent" BorderThickness="0" Foreground="Gray" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="40" Height="36" Margin="5,0"
                            IsVisible="{Binding HasMultipleShops}"
                            ToolTip.Tip="Фильтр по магазинам">
                        <avalonia:MaterialIcon Kind="FilterVariant"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    FlyoutPresenterClasses="transparentFlyout">
                                <Border Width="210" Padding="10" Background="White"
                                        BorderBrush="#D7E4EF" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Показывать сотрудников" FontWeight="SemiBold" Margin="4,2,4,4"/>
                                        <ListBox ItemsSource="{Binding EmployeeShopFilters}"
                                                 SelectedItem="{Binding SelectedEmployeeShopFilter, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Padding="6,4"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Width="40" Height="36" Margin="5,0" Command="{Binding ToggleCalendarViewModeCommand}">
                        <avalonia:MaterialIcon Kind="SwapHorizontal"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="6">
                <Grid Width="812" Height="30" ColumnDefinitions="*,*,*,*,*,*,*">
                    <TextBlock Grid.Column="0" Text="ПН" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#656565" />
                    <TextBlock Grid.Column="1" Text="ВТ" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#656565" />
                    <TextBlock Grid.Column="2" Text="СР" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#656565" />
                    <TextBlock Grid.Column="3" Text="ЧТ" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#656565" />
                    <TextBlock Grid.Column="4" Text="ПТ" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#656565" />
                    <TextBlock Grid.Column="5" Text="СБ" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#995B5B" />
                    <TextBlock Grid.Column="6" Text="ВС" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#995B5B" />
                </Grid>

                <ItemsControl ItemsSource="{Binding CalendarDays}" Width="812">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <view:CalendarDayControl Margin="3" MinHeight="125" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Row="2" Background="White" Margin="20,20,20,0" CornerRadius="15" BorderBrush="#D7E4EF" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,15" Background="#EAF4FB">
                        <TextBlock Text="{Binding FormattedMonthTitle}" FontSize="20" FontWeight="Bold" Foreground="#0077B5" />
                    </Border>

                    <Grid Grid.Row="1" Margin="20" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Общая статистика" FontWeight="SemiBold" FontSize="16" Foreground="#333333" Margin="0,0,0,15" />
                            <WrapPanel>
                                <Border Width="180" Height="90" Margin="0,0,15,15" CornerRadius="10" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
                                    <StackPanel Margin="15,10">
                                        <TextBlock Text="Матчи" Foreground="#666666" />
                                        <TextBlock Text="{Binding MonthMatchesCount}" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="90" Margin="0,0,15,15" CornerRadius="10" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
                                    <StackPanel Margin="15,10">
                                        <TextBlock Text="Сотрудники" Foreground="#666666" />
                                        <TextBlock Text="{Binding TotalEmployeesCount}" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="90" Margin="0,0,15,15" CornerRadius="10" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
                                    <StackPanel Margin="15,10">
                                        <TextBlock Text="Смены" Foreground="#666666" />
                                        <TextBlock Text="{Binding TotalShiftCount}" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="90" Margin="0,0,15,15" CornerRadius="10" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
                                    <StackPanel Margin="15,10">
                                        <TextBlock Text="ФОТ" Foreground="#666666" />
                                        <TextBlock Text="{Binding TotalSalary}" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <TextBlock Text="Сотрудники за месяц" FontWeight="SemiBold" FontSize="16" Foreground="#333333" Margin="0,0,0,15" />
                            <ItemsControl ItemsSource="{Binding EmployeeStatistics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#D7E4EF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding WorkDaysCount, Converter={StaticResource ShiftToRussian}}" FontSize="12" Foreground="#6E7E8F" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding TotalSalary}" FontSize="12" Foreground="#0A6DAE" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
