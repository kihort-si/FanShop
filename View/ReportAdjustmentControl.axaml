<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FanShop.View.ReportAdjustmentControl">
 <UserControl.Styles>
  <Style Selector="Border.report-card"><Setter Property="Background" Value="{StaticResource BrandSurfaceAlt}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="{StaticResource BrandBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="TextBlock.report-heading"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Styles>
 <ScrollViewer><StackPanel Margin="24" Spacing="16">
  <StackPanel Spacing="4"><TextBlock Text="Корректировка отчёта" FontSize="28" FontWeight="Bold"/><TextBlock Text="Анализ продаж • точный подбор • предпросмотр • инструкция для ручного оформления" Foreground="{StaticResource BrandTextSubtle}" TextWrapping="Wrap"/></StackPanel>
  <Border Classes="report-card"><StackPanel Spacing="10"><TextBlock Text="{Binding ReportPath}" TextWrapping="Wrap"/><WrapPanel><Button Content="Загрузить отчёт" Command="{Binding LoadReportCommand}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding ReportSummary}" Margin="16,8" FontWeight="SemiBold"/></WrapPanel><TextBlock Text="{Binding ImportWarnings}" TextWrapping="Wrap" FontSize="12"/></StackPanel></Border>
  <Border Classes="report-card" Background="#FFF4D6" IsVisible="{Binding HasRoundingWarning}"><StackPanel Spacing="8"><TextBlock Text="{Binding RoundingWarning}" TextWrapping="Wrap"/><CheckBox Content="Разрешить расчётный предпросмотр без гарантии соответствия 1С" IsChecked="{Binding AllowMismatchPreview}" IsEnabled="{Binding CanEdit}"/></StackPanel></Border>
  <Border Classes="report-card"><StackPanel Spacing="10" IsEnabled="{Binding CanEdit}"><TextBlock Classes="report-heading" Text="Требуемая корректировка"/><CheckBox Content="Учитывать конкретные позиции вместо общей суммы" IsChecked="{Binding UsePositions}"/>
   <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Сумма, ₽" VerticalAlignment="Center"/><TextBox Text="{Binding RequiredAmount}" Width="180" IsEnabled="{Binding !UsePositions}"/><TextBlock Text="Сумма добавляется к отчёту; подбор компенсирует её изменениями существующих строк." VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="550"/></StackPanel>
   <StackPanel IsVisible="{Binding UsePositions}" Spacing="8"><WrapPanel><Button Content="Добавить позицию" Command="{Binding AddPositionCommand}"/><Button Content="Удалить выбранную позицию" Command="{Binding RemovePositionCommand}" Margin="10,0"/></WrapPanel>
    <DataGrid ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}" Height="160" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Характеристика" Binding="{Binding Characteristic}" Width="170"/><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="125"/><DataGridTextColumn Header="Цена, ₽" Binding="{Binding BasePrice}" Width="110"/><DataGridTextColumn Header="Скидка, %" Binding="{Binding Discount}" Width="120"/></DataGrid.Columns></DataGrid>
   </StackPanel>
  </StackPanel></Border>
  <Border Classes="report-card"><StackPanel Spacing="10" IsEnabled="{Binding CanEdit}"><TextBlock Classes="report-heading" Text="Строки отчёта и разрешения"/><TextBlock Text="Размерные товары по умолчанию отключены. «Не изменять» запрещает и изменение скидки, и исключение строки." TextWrapping="Wrap" Foreground="{StaticResource BrandTextSubtle}"/>
   <WrapPanel><Button Content="Защитить выбранные" Command="{Binding ProtectSelectedCommand}"/><Button Content="Снять защиту выбранных" Command="{Binding UnprotectSelectedCommand}" Margin="10,0"/><Button Content="Защитить все размерные" Command="{Binding ProtectSizedCommand}"/></WrapPanel>
   <DataGrid Name="ReportRowsGrid" ItemsSource="{Binding Rows}" SelectionMode="Extended" SelectionChanged="OnReportSelectionChanged" Height="290" AutoGenerateColumns="False" GridLinesVisibility="Horizontal"><DataGrid.Columns>
    <DataGridTemplateColumn Header="Использовать&#10;в подборе" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding UseInSearch, Mode=TwoWay}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Не&#10;изменять" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsProtected, Mode=TwoWay}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Разрешить&#10;исключение" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding CanExclude, Mode=TwoWay}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Менять&#10;скидку" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding CanChangeDiscount, Mode=TwoWay}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="N" Binding="{Binding RowNumber}" IsReadOnly="True" Width="65"/><DataGridTextColumn Header="Номенклатура" Binding="{Binding ProductName}" IsReadOnly="True" Width="*" MinWidth="170"/><DataGridTextColumn Header="Хар-ка" Binding="{Binding Characteristic}" IsReadOnly="True" Width="90"/>
    <DataGridTemplateColumn Header="Тип / состояние" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Category}" Foreground="{Binding CategoryColor}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Цена" Binding="{Binding BasePrice}" IsReadOnly="True" Width="80"/><DataGridTextColumn Header="% руч." Binding="{Binding CurrentDiscount}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="Сумма" Binding="{Binding CurrentTotal}" IsReadOnly="True" Width="90"/>
   </DataGrid.Columns></DataGrid>
  </StackPanel></Border>
  <Expander Header="Настройки скидок, услуг и расчёта"><Border Classes="report-card"><StackPanel Spacing="10" IsEnabled="{Binding CanEdit}">
   <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Разрешённые скидки (разделитель ;)"/><TextBox Text="{Binding AllowedDiscounts}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Порядок предпочтения скидок (;)"/><TextBox Text="{Binding DiscountPriorities}"/></StackPanel>
    <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Услуги: одно точное название в строке"/><TextBox Text="{Binding ServiceNames}" AcceptsReturn="True" MinHeight="85"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8"><TextBlock Text="Округление суммы скидки"/><ComboBox ItemsSource="{Binding RoundingRules}" SelectedItem="{Binding Rounding}" HorizontalAlignment="Stretch"/><TextBlock Text="MathematicalRound — до целого рубля; DecimalRound2 — до копейки. Половины округляются от нуля." TextWrapping="Wrap" FontSize="12"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Количество вариантов" VerticalAlignment="Center"/><NumericUpDown Value="{Binding MaxSolutions}" Minimum="1" Maximum="100" Width="100"/></StackPanel></StackPanel>
   </Grid><CheckBox Content="Разрешать уменьшение существующей скидки" IsChecked="{Binding AllowDiscountDecrease}"/><CheckBox Content="Показывать ближайшее найденное отклонение (не точное решение)" IsChecked="{Binding ShowNearest}"/><Button Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
  </StackPanel></Border></Expander>
  <WrapPanel><Button Content="Найти варианты" Command="{Binding FindSolutionsCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="Расширить поиск на незащищённые размерные товары" Command="{Binding ExpandSearchCommand}" IsVisible="{Binding CanExpand}" IsEnabled="{Binding CanEdit}" Margin="10,0"/><Button Content="Отменить поиск" Command="{Binding CancelSearchCommand}" IsEnabled="{Binding IsBusy}" Margin="10,0"/></WrapPanel>
  <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsVisible="{Binding IsBusy}" Height="6"/>
  <Border Classes="report-card"><StackPanel Spacing="8"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding NearestMessage}" TextWrapping="Wrap" Foreground="{StaticResource BrandDanger}"/></StackPanel></Border>
  <Border Classes="report-card"><StackPanel Spacing="10"><TextBlock Classes="report-heading" Text="Лучшие варианты"/><ComboBox ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution}" HorizontalAlignment="Stretch" PlaceholderText="Выберите найденный вариант"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <WrapPanel><CheckBox Content="Показать весь отчёт после корректировки" IsChecked="{Binding ShowFullReport}"/><Button Content="Скопировать инструкцию" Command="{Binding CopyInstructionCommand}" Margin="16,0"/></WrapPanel><TextBlock Text="При выключенном флажке показаны только изменения. Исключённые строки отмечены явно и имеют итог 0." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BrandTextSubtle}"/>
   <DataGrid ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" Height="250"><DataGrid.Columns><DataGridTextColumn Header="Строка" Binding="{Binding RowNumber}" Width="95"/><DataGridTextColumn Header="Номенклатура" Binding="{Binding ProductName}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Хар-ка" Binding="{Binding Characteristic}" Width="110"/><DataGridTextColumn Header="Было %" Binding="{Binding OldDiscount}" Width="100"/><DataGridTextColumn Header="Стало %" Binding="{Binding NewDiscount}" Width="100"/><DataGridTextColumn Header="Было ₽" Binding="{Binding OldTotal}" Width="110"/><DataGridTextColumn Header="Стало ₽" Binding="{Binding NewTotal}" Width="110"/><DataGridTextColumn Header="Разница ₽" Binding="{Binding Delta}" Width="125"/><DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="190"/></DataGrid.Columns></DataGrid>
   <TextBlock Text="{Binding SolutionSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="Сведения НДС и документа реализации хранятся как в исходном отчёте. Итоговый НДС проверяется вручную в 1С." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrandTextSubtle}"/>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
