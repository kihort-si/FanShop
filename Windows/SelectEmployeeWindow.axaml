<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FanShop.Windows.SelectEmployeeWindow"
        Width="860"
        Height="560"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="Выбор сотрудника">
    <Border Margin="18"
            Padding="18"
            Background="White"
            CornerRadius="16"
            BoxShadow="0 0 34 0 #40000000">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Добавление сотрудника" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Сотрудники по активности за 30 дней. Добавляйте по одному, затем нажмите «Готово»." Foreground="#6E7E8F" />
        </StackPanel>

        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Поиск по фамилии, имени или отчеству" Margin="0,0,0,12" />
        <Grid Grid.Row="2" ColumnDefinitions="*,220">
            <Border Background="#F9FBFD" BorderBrush="{StaticResource BrandBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
                <DataGrid x:Name="EmployeesGrid"
                          ItemsSource="{Binding EmployeesWithStats}"
                          SelectedItem="{Binding SelectedEmployee}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          DoubleTapped="EmployeesGrid_DoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}" Width="*" />
                        <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*" />
                        <DataGridTextColumn Header="Отчество" Binding="{Binding LastName}" Width="*" />
                        <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" Background="#F9FBFD" BorderBrush="{StaticResource BrandBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel Spacing="10">

                    <TextBlock Text="Занятость"
                               FontWeight="Bold" />

                    <ComboBox x:Name="WorkDurationComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Целый день" />
                        <ComboBoxItem Content="Полдня" />
                    </ComboBox>

                    <Separator/>

                    <TextBlock Text="Магазин"
                               FontWeight="Bold" />

                    <ComboBox ItemsSource="{Binding Shops}"
                              SelectedItem="{Binding SelectedShop}"
                              IsEnabled="{Binding CanSelectShop}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShopName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Должность"
                               FontWeight="Bold" />

                    <ComboBox ItemsSource="{Binding AvailablePositions}"
                              SelectedItem="{Binding SelectedPosition}"
                              IsEnabled="{Binding CanSelectPosition}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PositionName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="AddedCountText" VerticalAlignment="Center" Margin="0,0,12,0" Text="Добавлено: 0" />
            <Button x:Name="AddSelectedButton" Content="Добавить" Click="SelectButton_Click" />
            <Button Content="Готово" Click="DoneButton_Click" />
            <Button x:Name="CancelButton" Classes="ghost" Content="Отмена" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
